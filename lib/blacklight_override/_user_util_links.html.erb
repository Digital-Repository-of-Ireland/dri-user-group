<%# This file overrides blacklights default view with the correct paths (Done so engine is compatiable with blacklight %>
<% if has_user_authentication_provider? %>
<% if current_user %>
  <%= link_to t('blacklight.header_links.logout'), user_group.destroy_user_session_path, method: "delete" %>
   [ <%= link_to current_user, user_group.user_path(:id => current_user.id.to_s)  %> ]
<% else %>
  <%= link_to t('blacklight.header_links.login'), new_user_session_path %>
<% end %>
    | 
<% end %>
    <%= link_to t('blacklight.header_links.bookmarks'), bookmarks_path %>
 <% if current_user %>
    |
    <%= link_to t('blacklight.header_links.saved_searches'), saved_searches_path %>
<% end %>
    |
<%= link_to t('blacklight.header_links.search_history'), search_history_path %>

