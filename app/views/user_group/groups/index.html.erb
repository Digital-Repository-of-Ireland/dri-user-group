<% if current_user.is_admin? %>
    <%= link_to (t :'user_groups.views.shared.add_group'), new_group_path %>
<% end %>

<h2> <%= (t :'user_groups.views.groups.index.groups') %>(<%= UserGroup::Group.count %>)</h2> 

<% UserGroup::Group.all.each do |group| %>
    <div class="index-element">
        <% if current_user.is_admin? %>
            <%= link_to group.name.capitalize, group %> 
            | 
            <%= (t :'user_groups.views.shared.delete') %>
            <%#= link_to "delete", group, method: :delete, confirm: "Are you sure?" %>
        <% else %>
            <b> <%= group.name.capitalize %> </b>
            <% if current_user.member?(group.id) %>
                | 
                <%= (t :'user_groups.views.groups.index.member') %>
            <% elsif current_user.pending_member?(group.id) %>
                | 
                <%= (t :'user_groups.views.groups.index.pending') %>
            <% else %>
                <% unless group.name == "admin" %>
                | <%= form_for(group.memberships.build, url: { controller: :memberships, action: :pending}) do |f| %>
                    <%= render 'shared/error_messages', object: f.object %>
                    <%= f.hidden_field :user_id, value: current_user.id %>
                    <%= f.hidden_field :group_id , value: group.id %>
                    <%= f.submit t :'user_groups.views.groups.index.apply' %>
                    <% end %>
                <% end %>
            <% end %>
        <% end %>
        <p><%= group.description %></p>
        <% if current_user.is_admin? %>
            <% amount_pending =  group.pending_memberships.count %>
            <% if amount_pending > 0 %>
                <%= link_to (t :'user_groups.views.groups.index.pending2'), edit_group_path(group) %>
                <%=  amount_pending %>
                <br />            
            <% end %>
        <% end %>
        <i><%= (t :'user_groups.views.groups.index.members') %></i> <%= group.full_memberships.count %>
    </div>
<% end %>
