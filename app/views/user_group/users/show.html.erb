<%= render :partial => "shared/header" %>

<% if current_user.is_admin? %>
    <div><%= link_to (t :'user_groups.views.shared.users'), users_path %></div>
<% end %>

<h2 class="no_bottom_margin"><%= @user.first_name %> <%= @user.second_name %></h2>
<br />
<div class="tab"><%= @user.email %></div>
<%= (t :'user_groups.views.shared.created') %><%= @user.created_at %><br />
<% if @user.created_at.to_s != @user.updated_at.to_s %>
    <%= (t :'user_groups.views.shared.updated') %> <%= @user.updated_at %><br />
<% end %>
<div>
<% if @user.is_admin? %>
    <%= (t :'user_groups.views.shared.admin') %>
<% else %>
    <%= (t :'user_groups.views.users.show.registered') %>
<% end %>
</dov>
<br />

<%#= @user.user_signed_in? %>
<%# https://groups.google.com/forum/?fromgroups=#!topic/plataformatec-devise/tOKU_jcWNp0 %>

<%= link_to (t :'user_groups.views.shared.edit'), edit_user_path %><br />

<h3 class="no_bottom_margin"><%= (t :'user_groups.views.users.show.sessions') %></h3>
<%= (t :'user_groups.views.users.show.total_sign_in') %> <%=@user.sign_in_count %><br />

<h4><%= (t :'user_groups.views.users.show.last_sign_in') %></h4>
<%= (t :'user_groups.views.users.show.time') %>
<%= @user.current_sign_in_at %><br />
<%= (t :'user_groups.views.users.show.ip') %>
<%= @user.current_sign_in_ip %>

<h3><%= pluralize(@user.groups.count, (t :'user_groups.views.users.show.membership')) %>:</h3>
<% if @user.groups.count > 0 %>
    <table border="0" class="table">
        <tr>
            <th><%=(t :'user_groups.views.users.show.group')%></th>
            <th><%=(t :'user_groups.views.shared.join_date')%></th>
            <th><%=(t :'user_groups.views.users.show.leave')%></th>
        </tr>
    <% groups = @user.groups.page(params[:page]) %>
    <%= paginate groups  %>
    <br />

    <% for group in groups %>
        <% membership = group.memberships.find_by_user_id(@user.id) %>
        <tr>
            <td><%= link_to group.name.capitalize, groups_path %></td>
            <% if membership.approved? %>
                <td><%= membership.updated_at %></td>
            <% else %>
                <td><%= (t :'user_groups.views.shared.pending') %></td>
            <% end %>

            <td><%#= button_to "X", membership_path(user_id: @user.id, group_id: group.id), method: :delete, remote: true, confirm: 'Are you sure?' %></td>
        </tr>
    <% end %>
    </table>
<% end %>