<%= form_for(object.memberships.build) do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <div><%= f.label :group_id %><br />
    <%= f.text_field :group_id %></div>
    
    <div><%= f.label :user_id %><br />
    <%= f.text_field :user_id %></div>
    
    <div><%= f.submit "Join Group" %></div>
<% end %>


