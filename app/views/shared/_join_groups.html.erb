<%= form_for(object.memberships.build) do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <% if object.is_a?(Group) %>
        <%= f.hidden_field :group_id %>
        <div><%= f.label :user_id , "User ID or Email" %><br />
        <%= f.text_field :user_id %></div>
    <% elsif object.is_a?(User) %>
        <%= f.hidden_field :user_id %>
        <div><%= f.label :group_id ,"Group ID or Name" %><br />
        <%= f.text_field :group_id %></div>
    <% end %>
    <div><%= f.submit "Join Group" %></div>
<% end %>


