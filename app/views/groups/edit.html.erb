<%= form_for(@group) do |f| %>
    <div><%= link_to "Back", @group %></div><br />

    <%= render 'shared/error_messages', object: f.object %>
    <% if @group.is_locked %>
        <p>Group details are locked</p>
        <%= link_to "Unlock Group", lock_group_path(@group), method: :put %>
    <% else %>
        <div><%= f.label :name %><br />
        <%= f.text_field :name , value: @group.name.capitalize %></div>

        <div><%= f.label :description %><br />
        <%= f.text_field :description %></div>

        <div><%= f.submit "Update" %></div>
        <br />
        <%= link_to "Lock Group", lock_group_path(@group), method: :put, confirm: "Locking the group protects the name and description from being changed. The group cannot be deleted. Proceed?" %>
    <% end %>
<% end %>
<% if !@group.is_locked %>
    <h3>Delete Group</h3>
    <%= link_to "Delete", @group, method: :delete, confirm: "Are you sure?" %>
<% end %>
<br />
<h3> Group Membership </h3>
<% #Rendering the other way does odd things %>
<h4 class="no_bottom_margin">Remove</h4>
<%= render 'shared/leave_groups', object: @group %>
<h4 class="no_bottom_margin">Pending</h4>
<%= render 'shared/pending_groups', object: @group %>
<h4 class="no_bottom_margin">Add</h4>
<%= render 'shared/join_groups', object: @group %>


