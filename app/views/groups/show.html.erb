<div><%= link_to "Groups", groups_path %></div>
<h2 class="no_bottom_margin"><%= @group.name.capitalize %></h2>
<div class="tab"><%= @group.description %></div>
Created At: <%= @group.created_at %>

<% if @group.created_at.to_s != @group.updated_at.to_s %>
    <br />Updated At: <%= @group.updated_at %>
<% end %>

<div class="clear"></div><br />
 <%= link_to "Edit Group", edit_group_path %>
<br />


<h3><%= pluralize(@group.users.count, "Member") %>:</h3>
<% if @group.users.count > 0 %>
    <table border="0" class="table">
    <tr>
        <th>Name</th>
        <th>Join Date</th>
        <th>Approved By</th>
    </tr>
    <% @group.users.each do |user| %>
        <tr>
            <td><%= link_to user.full_name, user_path(user) %></td>
            <td><%= user.updated_at %></td>

            <% membership = user.memberships.find_by_group_id(@group.id) %>
            <% if !membership.approved? %>
                <td>Pending <%#=link_to "Approve?", approve_membership_path(membership), method: :put %></td>
            <% else %>
                <% approving_user = User.find(membership.approved_by) %>
                <td><%= link_to approving_user.full_name, user_path(approving_user) %></td>
            <% end %>
        </tr>
    <% end %>
    </table>
<% end %>