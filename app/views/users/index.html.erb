<%= link_to "Add User", new_user_path %>

<h2> All users (<%= User.count %>)</h2> 
<% User.all.each do |user| %>
    <div class="index-element">
        <%= link_to user.first_name + " " + user.second_name, user %> | Delete<%#= link_to "delete", user, method: :delete, confirm: "Are you sure?" %>
        <p> <%= user.email %> </p>
        <% if user.is_admin? %>
        <p style="color:green">Admin User</p>
        <% end %>
    </div>
<% end %>