<!DOCTYPE html>
<html>
<head>
  <title>UserGroup</title>
  <%= stylesheet_link_tag    "user_group/application", :media => "all" %>
  <%= javascript_include_tag "user_group/application" %>
  <%= csrf_meta_tags %>
</head>
<body>
    <%= render 'layouts/header' %>
    
    <% flash.each do |key, value| %>
        <%= content_tag(:div, value, class: "alert alert-#{key}") %>
      <% end %>

    <%= yield %>
    <div class="clear"></div>
    <p><%= debug(params) if Rails.env.development? %></p>
</body>
</html>
