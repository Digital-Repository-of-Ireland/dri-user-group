    <div id="menu-wrapper">
      <div id="menu-wrapper-left">
        <ul>
          <li><%= link_to "Home", root_path %></li>
          <li><%= link_to "Help", help_path %></li>
          <% if signed_in? %>
            <li><%= link_to "Groups", groups_path %></li>
            <% if current_user.is_admin? %>
              <li><%= link_to "Users", users_path %></li>
              <li><%= link_to "Admin", admin_path %></li>
            <% end %>
          <% else %>
            <li><%= link_to "Sign in", new_user_session_path %></li>
          <% end %>
        </ul>
      </div>

        <% if signed_in? %>
          <div id="menu-wrapper-right">
            <ul>
              <li>
                <span id="menu-wrapper-right-name">
                  <%= current_user.first_name %> <%= current_user.second_name %>
                </span>
                (<span id="menu-wrapper-right-email"><%= current_user.email %></span>)
                <ul>
                  <li>
                    <%= link_to "My Account", current_user %>
                  </li>
                  <li>
                    <%= link_to "Sign out", destroy_user_session_path, method: "delete" %>
                  </li>
                </ul>
              </li>
            </ul>
        </div>
      <% end %>
    </div>