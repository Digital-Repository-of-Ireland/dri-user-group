    <div id="menu-wrapper">
      <div id="menu-wrapper-left">
        <ul>
          <li><%= link_to(t :'user_groups.views.header.home'), root_path %></li>
          <li><%= link_to (t :'user_groups.views.header.help'), help_path %></li>
          <% if signed_in? %>
            <li><%= link_to (t :'user_groups.views.shared.groups'), groups_path %></li>
            <% if current_user.is_admin? %>
              <li><%= link_to (t :'user_groups.views.shared.users'), users_path %></li>
              <li><%= link_to (t :'user_groups.views.header.admin'), admin_path %></li>
            <% end %>
          <% else %>
            <li><%= link_to (t :'user_groups.views.shared.sign_in'), new_user_session_path %></li>
            <li><%= link_to (t :'user_groups.views.shared.register'), new_user_path %></li>

          <% end %>
        </ul>
      </div>

        <% if signed_in? %>
          <div id="menu-wrapper-right">
            <ul>
              <li>
                <span id="menu-wrapper-right-name">
                  <%= current_user.first_name %> <%= current_user.second_name %>
                </span>
                (<span id="menu-wrapper-right-email"><%= current_user.email %></span>)
                <ul>
                  <li>
                    <%= link_to (t :'user_groups.views.header.account'), current_user %>
                  </li>
                  <li>
                    <%= link_to (t :'user_groups.views.header.signout'), destroy_user_session_path, method: "delete" %>
                  </li>
                </ul>
              </li>
            </ul>
        </div>
      <% end %>
    </div>